# Secrets des Edge Functions — à définir avec :  npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectés automatiquement par Supabase.)

# IA — https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=medium
AI_MAX_PER_HOUR=20

# Paiements — https://dashboard.stripe.com (mode test : sk_test_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_RETURN_URL=https://homemade.app/payouts/return
STRIPE_CONNECT_REFRESH_URL=https://homemade.app/payouts/refresh
SERVICE_FEE_RATE=0.05
PLATFORM_FEE_RATE=0.12
