# Secrets des Edge Functions — à définir avec :  npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectés automatiquement par Supabase.)

# IA GRATUITE — essayées dans l'ordre ; si toutes échouent, l'app passe en saisie manuelle.
# Gemini (recommandé) : clé gratuite sur https://aistudio.google.com/apikey (sans carte bancaire)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Groq (secours gratuit) : https://console.groq.com/keys
GROQ_API_KEY=
# Service compatible OpenAI au choix (ex. OpenRouter modèles « :free », Ollama derrière un tunnel)
# AI_CUSTOM_URL=https://openrouter.ai/api/v1
# AI_CUSTOM_MODEL=qwen/qwen2.5-vl-72b-instruct:free
# AI_CUSTOM_KEY=
# AI_PROVIDERS=gemini,groq,custom
AI_MAX_PER_HOUR=20

# Claude (Anthropic) — FACULTATIF et PAYANT, utilisé seulement en dernier recours si la clé est définie.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_EFFORT=medium

# Paiements — https://dashboard.stripe.com (mode test : sk_test_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_RETURN_URL=https://homemade.app/payouts/return
STRIPE_CONNECT_REFRESH_URL=https://homemade.app/payouts/refresh
SERVICE_FEE_RATE=0.05
PLATFORM_FEE_RATE=0.12
