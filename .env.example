# ── App (embarqué dans le bundle : AUCUN secret ici) ─────────────────────────
# Laisser vide = mode démo (données fictives, aucun backend requis).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── IA ───────────────────────────────────────────────────────────────────────
# local  = Qwen3-VL via Ollama sur le PC de développement (gratuit, relayé par Metro)
# server = Edge Function analyze-meal (IA gratuite Gemini / Groq, clés côté serveur)
EXPO_PUBLIC_AI_PROVIDER=local
EXPO_PUBLIC_LOCAL_AI_MODEL=qwen3-vl:2b-instruct

# ── Bêta fermée ──────────────────────────────────────────────────────────────
# Lien PUBLIC où vos testeurs téléchargent l'APK (ex. dossier Google Drive partagé). Ajouté aux invitations.
EXPO_PUBLIC_BETA_DOWNLOAD_URL=
